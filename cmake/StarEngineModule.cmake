function(starengine_register_module TARGET_NAME)
    set(_starengine_module_editor_only FALSE)
    file(GLOB _starengine_module_manifests "${CMAKE_CURRENT_SOURCE_DIR}/*.starmodule")
    foreach(_starengine_manifest ${_starengine_module_manifests})
        file(STRINGS "${_starengine_manifest}" _starengine_manifest_lines)
        foreach(_starengine_manifest_line ${_starengine_manifest_lines})
            if(_starengine_manifest_line STREQUAL "editorOnly=true")
                set(_starengine_module_editor_only TRUE)
            endif()
        endforeach()
    endforeach()

    if(_starengine_module_editor_only)
        set_property(GLOBAL APPEND PROPERTY STARENGINE_MODULE_LIBRARIES_EDITOR_ONLY ${TARGET_NAME})
    else()
        set_property(GLOBAL APPEND PROPERTY STARENGINE_MODULE_LIBRARIES ${TARGET_NAME})
    endif()
endfunction()
