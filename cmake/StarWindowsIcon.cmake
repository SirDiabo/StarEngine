if(WIN32)
    include(CheckLanguage)
    check_language(RC)
    if(CMAKE_RC_COMPILER)
        enable_language(RC)
    endif()
endif()

function(star_embed_windows_icon target iconFile)
    if(NOT WIN32 OR NOT CMAKE_RC_COMPILER)
        return()
    endif()
    if(NOT EXISTS "${iconFile}")
        message(WARNING "Windows icon not found: ${iconFile}")
        return()
    endif()
    file(SHA256 "${iconFile}" STAR_ICON_HASH)
    set(STAR_ICON_PATH "${iconFile}")
    set(rcFile "${CMAKE_BINARY_DIR}/${target}_icon.rc")
    configure_file("${CMAKE_SOURCE_DIR}/src/Resources/WindowsIcon.rc.in" "${rcFile}" @ONLY)
    target_sources(${target} PRIVATE "${rcFile}")
endfunction()

function(star_embed_windows_manifest target manifestFile)
    if(NOT WIN32 OR NOT CMAKE_RC_COMPILER)
        return()
    endif()
    if(NOT EXISTS "${manifestFile}")
        message(WARNING "Windows manifest not found: ${manifestFile}")
        return()
    endif()
    file(SHA256 "${manifestFile}" STAR_MANIFEST_HASH)
    set(STAR_MANIFEST_PATH "${manifestFile}")
    set(rcFile "${CMAKE_BINARY_DIR}/${target}_manifest.rc")
    configure_file("${CMAKE_SOURCE_DIR}/src/Resources/WindowsManifest.rc.in" "${rcFile}" @ONLY)
    target_sources(${target} PRIVATE "${rcFile}")
    if(MSVC)
        target_link_options(${target} PRIVATE /MANIFEST:NO)
    endif()
endfunction()
