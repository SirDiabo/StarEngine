if(WIN32)
    include(CheckLanguage)
    check_language(RC)
    if(CMAKE_RC_COMPILER)
        enable_language(RC)
    endif()
endif()

function(star_embed_windows_icon target iconFile)
    if(NOT WIN32 OR NOT CMAKE_RC_COMPILER)
        return()
    endif()
    if(NOT EXISTS "${iconFile}")
        message(WARNING "Windows icon not found: ${iconFile}")
        return()
    endif()
    file(SHA256 "${iconFile}" STAR_ICON_HASH)
    set(STAR_ICON_PATH "${iconFile}")
    set(rcFile "${CMAKE_BINARY_DIR}/${target}_icon.rc")
    configure_file("${CMAKE_SOURCE_DIR}/src/Resources/WindowsIcon.rc.in" "${rcFile}" @ONLY)
    target_sources(${target} PRIVATE "${rcFile}")
endfunction()
