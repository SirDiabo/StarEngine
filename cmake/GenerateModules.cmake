# CMake script to generate module registration file
# Called at build time to discover all modules in src/Modules/

if(NOT DEFINED MODULES_SOURCE_DIR)
    message(FATAL_ERROR "MODULES_SOURCE_DIR not set")
endif()

if(NOT DEFINED MODULES_OUTPUT_FILE)
    message(FATAL_ERROR "MODULES_OUTPUT_FILE not set")
endif()

file(MAKE_DIRECTORY ${CMAKE_SOURCE_DIR}/src/Modules)

# Find all .starmodule files in src/Modules/*/
file(GLOB MODULE_DIRS "${MODULES_SOURCE_DIR}/*")

set(MODULE_NAMES "")
set(MODULE_HEADERS "")

foreach(MODULE_DIR ${MODULE_DIRS})
    if(IS_DIRECTORY ${MODULE_DIR})
        get_filename_component(MODULE_NAME ${MODULE_DIR} NAME)
        
        # Check for .starmodule manifest
        if(EXISTS "${MODULE_DIR}/${MODULE_NAME}.starmodule")
            list(APPEND MODULE_NAMES ${MODULE_NAME}Module)
            list(APPEND MODULE_HEADERS "Modules/${MODULE_NAME}/${MODULE_NAME}Module.h")
        endif()
    endif()
endforeach()

# Generate the file
file(WRITE ${MODULES_OUTPUT_FILE}
"// Auto-generated by StarEngine module system
// Do not edit manually - regenerate by rebuilding

#pragma once
#include \"Core/Module.h\"

")

foreach(HEADER ${MODULE_HEADERS})
    file(APPEND ${MODULES_OUTPUT_FILE} "#include \"${HEADER}\"\n")
endforeach()

file(APPEND ${MODULES_OUTPUT_FILE} "\ninline void RegisterAllModules() {\n")

foreach(NAME ${MODULE_NAMES})
    file(APPEND ${MODULES_OUTPUT_FILE} "    ModuleManager::Get().Register(new ${NAME}());\n")
endforeach()

file(APPEND ${MODULES_OUTPUT_FILE} "}\n")

message(STATUS "Generated ${MODULES_OUTPUT_FILE} with ${MODULE_NAMES}")